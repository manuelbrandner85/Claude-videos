@@ -59,17 +65,42 @@ class _WorldTransitionVideoState extends State<WorldTransitionVideo>
     return 'materie';
   }
 
+  /// Gerichtete Übergangs-Videos die als Asset existieren (Ring-Reihenfolge:
+  /// Materie → Energie → Vorhang → Ursprung → Materie, in beide Richtungen).
+  static const Set<String> _availableDirectedVideos = {
+    'materie_to_energie',
+    'energie_to_materie',
+    'energie_to_vorhang',
+    'vorhang_to_energie',
+    'vorhang_to_ursprung',
+    'ursprung_to_vorhang',
+    'ursprung_to_materie',
+    'materie_to_ursprung',
+  };
+
   /// Video-Asset-Pfad ODER null wenn programmatische Animation nötig.
   String? get _videoAssetPath {
     final target = _effectiveTargetWorld;
-    // Nur Materie ↔ Energie haben echte Video-Assets
+    final source = widget.sourceWorld;
+
+    // 1) Wenn Quell-Welt bekannt: exaktes gerichtetes from→to-Video bevorzugen.
+    if (source.isNotEmpty && source != target) {
+      final key = '${source}_to_$target';
+      if (_availableDirectedVideos.contains(key)) {
+        return 'assets/videos/transition_$key.mp4';
+      }
+    }
+
+    // 2) Fallback ohne bekannte Quell-Welt: Target-basiert (Legacy Materie ↔ Energie).
     if (target == 'energie') {
       return 'assets/videos/transition_materie_to_energie.mp4';
     }
     if (target == 'materie') {
       return 'assets/videos/transition_energie_to_materie.mp4';
     }
-    return null; // Vorhang, Ursprung → programmatisch
+
+    // 3) Kein passendes Video (z.B. Nicht-Ring-Paar) → programmatische Animation.
+    return null;
   }
 
   /// Welt-Farb-Palette für die Ziel-Welt.
